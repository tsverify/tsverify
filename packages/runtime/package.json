{
  "name": "@tsverify/runtime",
  "version": "0.1.0-alpha.0",
  "description": "Replay scheduler and in-memory fakes imported by the tests tsverify generates",
  "keywords": [
    "tsverify",
    "testing",
    "vitest",
    "concurrency",
    "race-condition",
    "replay",
    "model-checking",
    "state-machine"
  ],
  "license": "Apache-2.0",
  "author": "The tsverify Authors",
  "homepage": "https://github.com/tsverify/tsverify/tree/main/packages/runtime#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsverify/tsverify.git",
    "directory": "packages/runtime"
  },
  "bugs": {
    "url": "https://github.com/tsverify/tsverify/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build && tsx ../../scripts/copy-release-files.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "devDependencies": {
    "@tsverify/ir": "workspace:*"
  }
}
