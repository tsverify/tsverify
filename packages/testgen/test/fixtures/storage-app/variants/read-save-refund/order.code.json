  "rules": [
    {
      "name": "Refund issued at most once per order",
      "kind": "always",
      "expr": {
        "type": "effect-count",
        "effect": "stripe.refund",
        "op": "<=",
        "value": 1
      },
      "source": "count(effect stripe.refund) <= 1"
    },
    {
      "name": "Shipped orders are never refunded",
      "kind": "never",
      "expr": {
        "type": "and",
        "left": {
          "type": "status-cmp",
          "op": "==",
          "value": "shipped"
        },
        "right": {
          "type": "effect-count",
          "effect": "stripe.refund",
          "op": ">",
          "value": 0
        }
      },
      "source": "status == shipped and count(effect stripe.refund) > 0"
    }
